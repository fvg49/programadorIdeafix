%form
// Form generated by IdeaFix [18/05/95 16:15]
language "c";
use sue;
window label "[Auditoria Retroactivos]", border single;
display status;
ignore delete, next, prev, add, ignore;
confirm update, end;

%fields
emp     : in sue.emps:(descrip), default $Nroempresa;
demp    : sue.emps.descrip, skip;

fechad : default today - 30;
fechah : default today;
consretro: in (true:"Si", false:"No"), default true;
correrror: in (true:"Si", false:"No"), default false, 
           is false when consretro=true;
salida : not null;
coment : skip;
