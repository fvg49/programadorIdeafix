
 Empresa        : __. ______________________________________

 Delegación Comercial  : _____  _________________________________
 Delegación Operacional: _____  _________________________________   
 Filial Operativa      : ______ _________________________________ 
 
 Opcion         :  _  __________________

 Legajo   Desde :{______. ______________________________________
          Hasta : ______.}______________________________________

 Cliente  Desde :{ _________. ______________________________________
          Hasta :  _________.}______________________________________

 Objetivo Desde :    {____. ______________________________________
          Hasta :     ____.}______________________________________

 Fecha    Desde :{__/__/____
          Hasta : __/__/____} 

 Salida         : _  ___________________  ____________________

                 ___________________________________________________
%form
// Form generated by IdeaFix [18/05/95 16:15]
language "c";
use sue, comerc, bill, billpro;
window label "[Listado de Presentismo]", border single;
display status;
ignore delete, next, prev, add, ignore;
confirm update, end;
messages
		ERR_CLIE : "El Legajo Desde debe ser menor o igual al Legajo Hasta";

%fields
emp     : in emps:(descrip), default $emp;
demp    : emps.descrip, skip;

deleg   : in billpro.delega : descrip, mask "5>a";
ddeleg  : billpro.delega.descrip, skip;
fdelega : in billpro.delega: descrip, mask "5>a";
ddelega : billpro.delega.descrip, skip;
ffilial : on help manual;
descrip : comerc.filial.descrip, skip;

opcion  : in ("C":"Cliente/Objetivo",
              "P":"Presentismo",
              "G":"Programador",
              "S":"Supervisor"), not null, default "P", mask "1>A", autoenter;
dopcion : is descr(opcion);

agrsup  : check (nrolegd <= nrolegh), skip when opcion == "C";
nrolegd : in per(emp):apynom;
apynomd : per.apynom, skip;
nrolegh : in per(emp):apynom descending;
apynomh : per.apynom, skip;

agrcli  : check (clied <= clieh), skip when opcion == "P" or opcion == "G" or opcion == "S";
clied   : on help manual, default 1, not null;
dclied  : skip;
clieh   : on help manual, default 9999, not null;
dclieh  : skip;
agrobj  : skip when opcion == "P" or opcion == "G" or opcion == "S";
objetd  : on help manual, default 1, not null;
dobjd   : skip;
objeth  : on help manual, default 99, not null;
dobjh   : skip;

agrupf  : check fechad <= fechah;
fechad  : not null, default today;
fechah  : not null, default today;
salida  : in ("T":"Terminal",
              "I":"Impresora",
              "A":"Archivo",
              "C":"Operaciones Central"),
          default "T", mask ">A", not null;
desc5   : is descr(salida);
archivo : is (salida == "A" or salida == "C") ? void : null, not null;
coment  : skip;
