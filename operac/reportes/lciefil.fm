
 Filial Desde : ______ _________________________________ 
        
        Hasta : ______ _________________________________ 

 Fecha  Desde :{__/__/____
        
        Hasta : __/__/____} 

 Salida       : _  ___________________  ____________________

%form
// Form generated by IdeaFix [18/05/95 16:15]
language "c";
use operac, comerc;
window label "[Listado de Cierre por Filial]", border single;
display status;
ignore delete, next, prev, add, ignore;
confirm update, end;

%fields
fildes  : on help manual;
dfildes : comerc.filial.descrip, skip;
filhas  : on help manual;
dfilhas : comerc.filial.descrip, skip;

agrupf  : check fechad <= fechah;
fechad  : not null, default today;
fechah  : not null, default today;
salida  : in ("T":"Terminal",
              "I":"Impresora",
              "A":"Archivo"),
          default "T", mask ">A", not null;
dsalida : is descr(salida);
archivo : is (salida == "A") ? void : null, not null;
