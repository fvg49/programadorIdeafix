%form
// Form generated by IdeaFix [18/05/95 16:15]
language "c";
use operac, sue, bill, comerc;
window label "[Vigiladores por Localidad]", border single;
display status;
ignore delete, next, prev, add, ignore;
confirm update, end;

%fields
emp     : in sue.emps:(descrip), default $Nroempresa;
demp    : sue.emps.descrip, skip;
codpais	: in sue.pais:(descrip), not null, default 1 ;
dpais   : sue.pais.descrip, skip;

multip	: rows 50, display 5;
fprovi	: in sue.provi(codpais):denom;
dprovi	: sue.provi.denom, skip;
flocal	: in sue.locali(codpais,fprovi):descrip;
dlocal	: sue.locali.descrip, skip;

multipol: rows 50, display 2;
palta	: in sue.provi(codpais):denom;
dpalta	: sue.provi.denom, skip;

provis	 : in ("P":"Provisorio",
			   "E":"Efectivo",
			   "T":"Todos "), not null, default "E", mask ">A", autoenter;
dprovis	 : is descr(provis);

insclu   : in ("C":"Con CLU",
			   "S":"Sin CLU",
			   "T":"Todos"), default "T", mask ">A", autoenter;
dinsclu  : is descr(insclu);

portac   : in ("P":"Portación",
			   "S":"Sin Portación",
			   "T":"Todos"), default "T", mask ">A", autoenter;
dportac  : is descr(portac);

salida  : in ("T":"Terminal",
              "I":"Impresora",
              "A":"Archivo"),
          default "I", mask ">A", not null, autoenter;
desc5   : is descr(salida);
darchivo: is (salida == "A") ? "Nombre de Archivo:" : null;
archivo : is (salida == "A") ? void : null, not null;
avance  : skip;
