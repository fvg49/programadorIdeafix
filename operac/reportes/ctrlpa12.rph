/* Field names	*/
# define R_FECHAD        ((rpfield)   0) 	/* Date */
# define R_FECHAH        ((rpfield)   1) 	/* Date */
# define R_NROLEG        ((rpfield)   2) 	/* Num */
# define R_NOMBRE        ((rpfield)   3) 	/* String */
# define R_DIA           ((rpfield)   4) 	/* Date */
# define R_CLIENTE       ((rpfield)   5) 	/* Num */
# define R_DCLIENTE      ((rpfield)   6) 	/* String */
# define R_OBJET         ((rpfield)   7) 	/* Num */
# define R_DOBJET        ((rpfield)   8) 	/* String */
# define R_REGIMEN       ((rpfield)   9) 	/* String */
# define R_HORAS         ((rpfield)  10) 	/* Num */
/* Report Checksum	*/
# define RP_CTRLPA12_CHKSUM ((long) 0x0070)
/* Zone names	*/
# define HEAD            ((int)   0)
# define LINEA1          ((int)   1)
# define TOTLEG          ((int)   2)
