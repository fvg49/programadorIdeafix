
 Empresa         : __. ______________________________________________

 Delegación Comercial  : _____  _________________________________
 Delegación Operacional: _____  _________________________________   
 Filial Operativa      : ______ _________________________________ 
  
 Opción          :  _  __________________

 Cliente   Desde : {_________.  _________________________________________
           Hasta :  _________.} _________________________________________

 Objetivo  Desde :     {____.  _________________________________________
           Hasta :      ____.} _________________________________________

 Vigilador Desde :{______.  _________________________________________
           Hasta : ______.} _________________________________________

 Salida          :  _ _________  ____________________

                 ___________________________________________________
%form
// Form generated by IdeaFix [18/05/95 16:15]
language "c";
use operac, sue, bill, comerc, billpro;
window label "[Asignación de Vigiladores en Puestos Vencidos]", border single;
display status;
ignore delete, next, prev, add, ignore;
confirm update, end;
messages
		ERR_CLIE : "El Cliente Desde debe ser menor o igual al Cliente Hasta";

%fields
emp     : in sue.emps:(descrip), default $emp, not null;
demp    : sue.emps.descrip, skip;

deleg   : in billpro.delega : descrip, mask "5>a";
ddeleg  : billpro.delega.descrip, skip;
fdelega : in billpro.delega: descrip, mask "5>a";
ddelega : billpro.delega.descrip, skip;
ffilial : on help manual;
descrip : comerc.filial.descrip, skip;

opcion  : in ("C":"Cliente/Objetivo", "V":"Vigilador"), not null, default "C", mask "1>A";
dopcion : is descr(opcion);

agrclie : check (clid <= clih), skip when opcion == "V", on error ERR_CLIE;
clid    : on help manual, default 1, not null,
          is (opcion == "C") ? void : null;
dclid   : skip;
clih    : on help manual, default 999999999, not null,
          is (opcion == "C") ? void : null;
dclih   : skip;

agrobje : skip when opcion == "V";
objd    : on help manual, default 1, not null,
          is (opcion == "C") ? void : null;
dobjd   : skip;
objh    : on help manual, default 9999, not null,
          is (opcion == "C") ? void : null;
dobjh   : skip;

agrsup  : check (vigid<= vigih), skip when opcion == "C";
vigid   : in sue.per(emp):apynom, is (opcion == "V") ? void : null, not null;
apynomd : sue.per.apynom, skip;
vigih   : in sue.per(emp):apynom descending, is (opcion == "V") ? void : null, not null;
apynomh : sue.per.apynom, skip;

salida  : in ("T":"Terminal",
              "I":"Impresora",
              "A":"Archivo"),
          default "T", mask ">A", not null;
desc5   : is descr(salida);
archivo : is (salida == "A") ? void : null, not null;

coment  : skip;
