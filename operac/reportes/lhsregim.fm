
	Empresa: __. ____________________________________________

	Fecha Desde :{__/__/____ Hasta : __/__/____}

	Regimen : ________

	Cantidad de Horas : ____.__

	Opcion : _ __________________________

	Salida : _ __________________________ ____________________

%form 
use comerc, sue;
language "c";
window label "Listado de Control de Horas por Regimen", border single;
confirm update, ignore, end;
ignore add, delete, prev, next;

%fields
emp	   : in sue.emps:descrip, default $emp, not null;
demp   : sue.emps.descrip, skip;
agrfec : check (fechad <= fechah);
fechad : not null;
fechah : not null;
regim  : in regimen by regi, not null;
cant   : not null;
opcion : in ("T":"Totales", "D":"Detalle"), not null, mask ">A", default "T";
dopcion: is descr(opcion);
salida : in ("I": "Impresora", "T":"Terminal", "A":"Archivo"), not null, default "I", mask ">A";
dsalida: is descr(salida);
archivo: skip when salida != "A", default "horas.txt";
