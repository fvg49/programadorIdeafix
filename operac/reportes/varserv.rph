# define R_HHASTA        ((rpfield)   9) 	/* Time */
# define R_D1            ((rpfield)  10) 	/* String */
# define R_D2            ((rpfield)  11) 	/* String */
# define R_D3            ((rpfield)  12) 	/* String */
# define R_D4            ((rpfield)  13) 	/* String */
# define R_D5            ((rpfield)  14) 	/* String */
# define R_D6            ((rpfield)  15) 	/* String */
# define R_D7            ((rpfield)  16) 	/* String */
