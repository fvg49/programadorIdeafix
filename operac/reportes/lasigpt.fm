
 Empresa            : __. __________________________________
 Ordenamiento       :  _. __________________________________
 Tipo de Información:  _  __________________ Detalle Dias?: __?

 Cliente   Desde :{_________. ______________________________
           Hasta : _________. ______________________________}

 Objetivo  Desde :     {__. ______________________________
           Hasta :      __. ______________________________}

 Vigilador Desde :  {_______. ______________________________
           Hasta :   _______. ______________________________}

 Período   Desde :{__/__/____ al __/__/____}

 Salida : _  _______________ ____________________ 

%form
// Form generated by IdeaFix [18/05/95 16:15]
language "c";
use     operac, sue, bill, comerc;
window  label "[Asignación de Vigiladores Part Time]",border single;
display status;
ignore  delete, next, prev, add;
confirm update, end;
messages
  ERR_VIGI:   "El Vigilador Desde debe ser Menor o Igual al Vigilador Hasta.",
  ERR_CLI:    "El Cliente Desde debe ser Menor o Igual al Cliente Hasta.",
  ERR_OBJ:    "El Objetivo Desde debe ser Menor o Igual al Objetivo Hasta.",
  ERR_FECHA:  "La Fecha Desde debe ser Menor o Igual al Objetivo Hasta.",
  ERR_FDESDE: "La Fecha Desde debe ser Menor o Igual a la Fecha de Hoy.",
  ERR_FHASTA: "La Fecha Hasta debe ser Menor o Igual a la Fecha de Hoy.";
%fields
c_emp       : in sue.emps:(descrip), default $Nroempresa;
x_emp       : sue.emps.descrip,skip;
t_orden     : in  (1: "Cliente/Objetivo",
                   2: "Vigilador"), not null, default 1, has after;
x_orden     : is descr(t_orden);
t_info      : in ("A": "Actual",
                  "H": "Historica"), not null, default "A";
x_tinfo     : is descr(t_info);
m_dias      : not null, default false;
agrup_cli   : check (c_clid <= c_clih or c_clid == null or c_clih == null), on error ERR_CLI;
c_clid      : on help in bill.cliente: (razsoc);
x_clid      : bill.cliente.razsoc,skip;
c_clih      : on help in bill.cliente: (razsoc);
x_clih      : bill.cliente.razsoc,skip;
agrup_obj   : check (obj_d <= obj_h or obj_d = null or obj_h == null), on error ERR_OBJ;
obj_d       : on help in comerc.objetivo by est(c_emp, true, c_clid): descrip, default 1;
x_objd      : comerc.objetivo.descrip,skip;
obj_h       : on help in comerc.objetivo by est(c_emp, true, c_clih): descrip, default 99;
x_objh      : comerc.objetivo.descrip,skip;
agrup_vigi  : check (vig_d <= vig_h or vig_d = null or vig_h = null), on error ERR_VIGI;
vig_d       : on help in sue.per(c_emp): (apynom);
x_vigd      : sue.per.apynom,skip;
vig_h       : on help in sue.per(c_emp): (apynom);
x_vigh      : sue.per.apynom,skip;
agrup_fecha : check (f_d <= f_h), on error ERR_FECHA;
f_d         : not null, default today - 30, check(f_d <= today), on error ERR_FDESDE;
f_h         : not null, default today, check(t_info == "H" and f_h <= today or t_info == "A"),
              on error ERR_FHASTA;
salida      : in ("T":"Terminal",
                  "I":"Impresora",
                  "A":"Archivo"), not null, default "T", mask ">A", not null;
x_salida    : is descr(salida);
x_archivo   : is (salida == "A") ? void : null, not null;
