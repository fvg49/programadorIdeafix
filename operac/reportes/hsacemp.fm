 Delegación Comercial  : _____  _________________________________
 Delegación Operacional: _____  _________________________________   
 Filial Operativa      : ______ _________________________________ 
 
 Desde Cliente : {___,___,___.   _________________________________
       Objetivo:        _,___.   _________________________________

 Hasta Cliente :  ___,___,___.}  _________________________________
       Objetivo:        _,___.   _________________________________

 Período Desde : {__/__/____
         Hasta :  __/__/____}

 Considera Retroactivos : __?

 Tipo de Servicio : _ __________________________

 Detalle  : _ ___________________________________________

 Salida a : _ ______________ Nombre del archivo: _______________

                 ___________________________________________________
%form
use operac, bill, sue, comerc, billpro;
language "C";
window label "[Listado de Horas a Cargo de la Empresa]", border single;
confirm update, ignore, end;
ignore add, delete;

%fields
emp     : in sue.emps:(descrip), default $emp, not null;
demp    : sue.emps.descrip, skip;

deleg   : in billpro.delega : descrip, mask "5>a";
ddeleg  : billpro.delega.descrip, skip;
fdelega : in billpro.delega: descrip, mask "5>a";
ddelega : billpro.delega.descrip, skip;
ffilial : on help manual;
descrip : comerc.filial.descrip, skip;

agrupc  : check clid <= clih;
clid    : on help manual, default 1, not null;
dclid   : skip;
objd    : on help manual, default 1, not null;
dobjd   : skip;
clih    : on help manual, default 999999999, not null;
dclih   : skip;
objh    : on help manual, default 9999;
dobjh   : skip;

agrupf  : check fechad <= fechah;
fechad  : not null, default today;
fechah  : not null, default today;
fretro  : not null, default false;

objbri  : in ("V": "Vigilancia",
              "B": "Brigada",
              "T": "Todos"), not null, default "V", mask ">A";
dobjbri : is descr(objbri);

det     : in ("C":"Consolida por Cliente",
              "O":"Consolida por Objetivo",
              "P":"Consolida por Puesto",
              "F":"Consolida por Fecha",
              "L":"Detalla Legajos"),
          not null, default "L", mask ">A", autoenter;
ddet    : is descr(det);

salida  : in ("I": "Impresora",
              "T": "Terminal",
			  "A": "Archivo",
              "R": "Assist"),
          not null, default "I", mask ">A", autoenter;
saldescr: is descr(salida);
nomarch : is (salida != "A" and salida != "R") ? null : void, default "hscliobj.dat", not null;
coment  : skip;
