
 Empresa         :         __. _________________________________________

 Vigilador Desde :   {_______. _________________________________________
           Hasta :    _______.}_________________________________________

 Fecha Desde     :{__/__/____
       Hasta     : __/__/____}

 Salida          : _  _________  ____________________

%form
// Form generated by IdeaFix [18/05/95 16:15]
language "c";
use sue;
window label "[Detalle de Francos Cargados/Trabajados]", border single;
display status;
ignore delete, next, prev, add, ignore;
confirm update, end;
messages
		ERR_VIGI : "El Vigilador Desde debe ser menor o igual al Vigilador Hasta",
		ERR_FEC  : "La Fecha Desde debe ser menor o igual a la Fecha Hasta";

%fields
w0_emp     : in sue.emps:(descrip), default $emp, not null;
w0_demp    : sue.emps.descrip, skip;

w0_agrvigi : check (w0_vigdesde <= w0_vighasta),	on error ERR_VIGI;
w0_vigdesde: on help in sue.per(w0_emp):(apynom), default 0, not null;
w0_dvigd   : sue.per.apynom, skip;
w0_vighasta: on help in sue.per(w0_emp):(apynom) descending, default 9999999, not null;
w0_dvigh   : sue.per.apynom, skip;

w0_agrfec  : check (w0_fechad <= w0_fechah),	on error ERR_FEC;
w0_fechad  : not null;
w0_fechah  : not null;

w0_salida  : in ("T":"Terminal",
              "I":"Impresora",
              "A":"Archivo"),
          default "A", mask ">A", not null;
w0_desc5   : is descr(w0_salida);
w0_nomarch : is (w0_salida == "A") ? void : null, not null;

