
 Empresa         :        __. ______________________________________________

 Delegación Comercial  : _____  _________________________________
 Delegación Operacional: _____  _________________________________   
 Filial Operativa      : ______ _________________________________ 

 Listar por      :         _. ______________________________________________

 Cliente Desde   :{___,___,___. _________________________________________
         Hasta   : ___,___,___.}_________________________________________
                   
 Objetivo Desde  :      {_,___. _________________________________________
          Hasta  :       _,___.}_________________________________________

 Vigilador Desde :  {_______. _________________________________________
           Hasta :   _______.}_________________________________________

 Fecha Desde     : {__/__/____
       Hasta     :  __/__/____}

 Considerar retroactivos? : __?

 Salida          : _  _________  ____________________

                 ___________________________________________________
%form
// Form generated by IdeaFix [18/05/95 16:15]
language "c";
use operac, sue, bill, comerc, billpro;
window label "[Control de Ausentismo por Vigilador]", border single;
display status;
ignore delete, next, prev, add, ignore;
confirm update, end;
messages
		ERR_VIGI : "El Vigilador Desde debe ser menor o igual al Vigilador Hasta",
		ERR_CLIE : "El Cliente Desde debe ser menor o igual al Cliente Hasta",
		ERR_OBJE : "El Objetivo Desde debe ser menor o igual al Objetivo Hasta",
		ERR_BON  : "El Bono Desde debe ser menor o igual al Bono Hasta",
		ERR_FEC  : "La Fecha Desde debe ser menor o igual a la Fecha Hasta";

%fields
emp     : in sue.emps:(descrip), default $emp, not null;
demp    : sue.emps.descrip, skip;

deleg   : in billpro.delega : descrip, mask "5>a";
ddeleg  : billpro.delega.descrip, skip;
fdelega : in billpro.delega: descrip, mask "5>a";
ddelega : billpro.delega.descrip, skip;
ffilial : on help manual;
descrip : comerc.filial.descrip, skip;

listapor: in (1 : "Cliente/Objetivo",
              2 : "Vigilador"),
          not null, has after;
dlispor : is descr(listapor);

agrclie : check (clidesde <= clihasta), on error ERR_CLIE;
clidesde: on help manual, not null, default 1,
          	is (listapor==1? void : null);
dclid   : skip;
clihasta: on help manual, not null, default 999999999,
          	is (listapor==1? void : null);            
dclih   : skip;

agrobje : ;
objdesde: on help manual, default 1, not null, is (listapor==1? void : null);
dobjd   : skip;
objhasta: on help manual, not null, is (listapor==1? void : null), default 9999;
dobjh   : skip;

agrvigi : check (vigdesde <= vighasta),	on error ERR_VIGI;
vigdesde: on help in sue.per(emp):(apynom), 
			is (listapor == 2 ? void : null), default 0, not null;
dvigd   : sue.per.apynom, skip;
vighasta: on help in sue.per(emp):(apynom) descending, 
			is (listapor == 2 ? void : null), default 9999999, not null;
dvigh   : sue.per.apynom, skip;

agrfec  : check (fechad <= fechah),	on error ERR_FEC;
fechad  : not null;
fechah  : not null;

fretro	: default false, not null;

salida  : in ("T":"Terminal",
              "I":"Impresora",
              "A":"Archivo"),
          default "T", mask ">A", not null;
desc5   : is descr(salida);
nomarch : is (salida == "A") ? void : null, not null;
coment  : skip;

