/* Field names	*/
# define R_FECHAD        ((rpfield)   0) 	/* Date */
# define R_FECHAH        ((rpfield)   1) 	/* Date */
# define R_NROLEG        ((rpfield)   2) 	/* Num */
# define R_NOMBRE        ((rpfield)   3) 	/* String */
# define R_DIA           ((rpfield)   4) 	/* Date */
# define R_REGIM         ((rpfield)   5) 	/* String */
# define R_TOTHS         ((rpfield)   6) 	/* Num */
# define R_OBS           ((rpfield)   7) 	/* String */
/* Report Checksum	*/
# define RP_CTRLPA11_CHKSUM ((long) 0x0046)
/* Zone names	*/
# define HEAD            ((int)   0)
# define LINEA           ((int)   1)
