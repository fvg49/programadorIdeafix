
 Empresa    : __. ______________________________________________

 Listar por :  _. ______________________________________________

 Cliente   Desde :{_________.  _________________________________________
           Hasta : _________.} _________________________________________

 Objetivo  Desde :     {____.  _________________________________________
           Hasta :      ____.} _________________________________________

 Vigilador Desde :  {_______.  _________________________________________
           Hasta :   _______.} _________________________________________

 Salida          : _  _________  ____________________

                             _______________________________________________

%form
// Form generated by IdeaFix [18/05/95 16:15]
language "c";
use operac, sue, bill, comerc;
window label "[Listado de Asignaciones de Vigiladores Part Time]", border single;
display status;
ignore delete, next, prev, add, ignore;
confirm update, end;
messages
		ERR_VIGI : "El Vigilador Desde debe ser menor o igual al Vigilador Hasta",
		ERR_CLIE : "El Cliente Desde debe ser menor o igual al Cliente Hasta";

%fields
emp     : in sue.emps:(descrip), default $Nroempresa;
demp    : sue.emps.descrip, skip;
listapor: in (1 : "Cliente/Objetivo",
              2 : "Vigilador"), not null, has after;
dlispor : is descr(listapor);
agrclie : check (clidesde <= clihasta), on error ERR_CLIE;
clidesde: on help in bill.cliente:(razsoc), not null, default 0, is (listapor == 1) ? void : null;
dclid   : bill.cliente.razsoc, skip;
clihasta: on help in bill.cliente:(razsoc), not null, is (listapor == 1) ? void : null, default 999999999;
dclih   : bill.cliente.razsoc, skip;
agrobje : ;
objdesde: on help in comerc.objetivo by est(emp, true, clidesde):descrip, not null,
          is (listapor == 1) ? void : null, default 1;
dobjd   : comerc.objetivo.descrip, skip;
objhasta: on help in comerc.objetivo by est(emp, true, clihasta):descrip, not null,
          is (listapor == 1) ? void : null, default 99;
dobjh   : comerc.objetivo.descrip, skip;
agrvigi : check (vigdesde <= vighasta), on error ERR_VIGI;
vigdesde: on help in sue.per(emp):(apynom), is (listapor == 2) ? void : null, default 0, not null;
dvigd   : sue.per.apynom, skip;
vighasta: on help in sue.per(emp):(apynom) descending, is (listapor == 2) ? void : null, default 9999999, not null;
dvigh   : sue.per.apynom, skip;
salida  : in ("T":"Terminal",
              "I":"Impresora",
              "A":"Archivo"), default "T", mask ">A", not null;
desc5   : is descr(salida);
nomarch : is (salida == "A") ? void : null, not null;
coment  : skip;
