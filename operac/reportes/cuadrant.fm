
 Empresa         : __. ______________________________________________

 Periodo         : __. ______________________________

 Opción          :  _  __________________

 Legajo    Desde :{_______.  _________________________________________
           Hasta : _______.} _________________________________________

 Cliente   Desde :{   ____.  _________________________________________
           Hasta :    ____.} _________________________________________

 Objetivo  Desde :   {____.  _________________________________________
           Hasta :    ____.} _________________________________________

 Archivo         : ____________________
                  
%form
// Form generated by IdeaFix [18/05/95 16:15]
language "c";
use operac, sue, bill, comerc;
window label "[Listado del Cuadrante]", border single;
display status;
ignore delete, next, prev, add, ignore;
confirm update, end;
messages
		ERR_LEG  : "El Legajo Desde debe ser menor o igual al Legajo Hasta",
		ERR_CLIE : "El Cliente Desde debe ser menor o igual al Cliente Hasta";

%fields
emp     : in sue.emps:(descrip), default $emp, not null;
demp    : sue.emps.descrip, skip;

mes     : in (1: "Enero", 2: "Febrero", 3: "Marzo", 4: "Abril", 5: "Mayo",
              6: "Junio", 7: "Julio", 8: "Agosto", 9: "Septiembre", 10: "Octubre",
             11: "Noviembre", 12: "Diciembre"), not null;
dmes    : is descr (mes);

opcion  : in ("C":"Cliente/Objetivo",
              "P":"Presentismo",
              "G":"Programador",
              "S":"Supervisor"), not null, default "C", mask "1>A";
dopcion : is descr(opcion);

agrsup  : check (nrolegd<= nrolegh), skip when opcion == "C", on error ERR_LEG;
nrolegd : in sue.per(emp):apynom, is (opcion == "P") ? void : null, not null;
apynomd : sue.per.apynom, skip;
nrolegh  : in sue.per(emp):apynom descending, is (opcion == "P") ? void : null, not null;
apynomh : sue.per.apynom, skip;

agrclie : check (clied <= clieh), skip when opcion == "P", on error ERR_CLIE;
clied    : on help in bill.cliente:(razsoc), default 1, not null,
          is (opcion == "C") ? void : null;
dclid   : bill.cliente.razsoc, skip;
clieh    : on help in bill.cliente:(razsoc), default 999999999, not null,
          is (opcion == "C") ? void : null;
dclih   : bill.cliente.razsoc, skip;

agrobje : check (objetd <= objeth), skip when opcion == "P";
objetd    : on help in comerc.objetivo by est(emp, true, clied):descrip, default 1, not null,
          is (opcion == "C") ? void : null;
dobjd   : comerc.objetivo.descrip, skip;
objeth    : on help in comerc.objetivo by est(emp, true, clieh):descrip, default 99, not null,
          is (opcion == "C") ? void : null;
dobjh   : comerc.objetivo.descrip, skip;

archivo : default "cuadrante.txt", not null;
