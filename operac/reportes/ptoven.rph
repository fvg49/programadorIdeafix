/* Field names	*/
# define R_LEGAJO        ((rpfield)   0) 	/* Num */
# define R_APYNOM        ((rpfield)   1) 	/* String */
# define R_CLI           ((rpfield)   2) 	/* Num */
# define R_DCLI          ((rpfield)   3) 	/* String */
# define R_OBJ           ((rpfield)   4) 	/* Num */
# define R_DOBJ          ((rpfield)   5) 	/* String */
# define R_FILIAL        ((rpfield)   6) 	/* String */
# define R_PTOSER        ((rpfield)   7) 	/* Num */
# define R_PUESTO        ((rpfield)   8) 	/* Num */
# define R_DPTOSER       ((rpfield)   9) 	/* String */
# define R_FINICIO       ((rpfield)  10) 	/* Date */
# define R_FFINAL        ((rpfield)  11) 	/* Date */
/* Report Checksum	*/
# define RP_PTOVEN_CHKSUM ((long) 0x0099)
/* Zone names	*/
# define HEAD            ((int)   0)
# define LINEA           ((int)   1)
# define FIN             ((int)   2)
