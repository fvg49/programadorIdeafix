   ¨¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡ª
    Procesando Vigilador   :_______. ________________________________________________ 
   ¢¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡¤
%form
use sue, bill, comerc, billpro;
language "c";
window label "[Listado de Categorías por Empleado]", border single;
ignore add, delete, next, prev;
confirm update, end;
display status;
messages
		ERR_FECHAS : "La Fecha Desde debe ser menor o igual a la Fecha Hasta",
		ERR_CLIE   : "El Cliente Desde debe ser menor o igual al Cliente Hasta",
		ERR_OBJE   : "El Objetivo Desde debe ser menor o igual al Objetivo Hasta",
		ERR_VIGI   : "El Vigilador Desde debe ser menor o igual al Vigilador Hasta";

%fields
emp     : in sue.emps:descrip, default $emp, not null;
demp    : sue.emps.descrip, skip;
listapor: in (1 : "Cliente/Objetivo",
			  2 : "Vigilador"),
		  not null,	has after;
dlispor : is descr(listapor);
agrfec  : check (fdesde <= fhasta), on error ERR_FECHAS;
fdesde  : default today;
fhasta  : default today;

fdeleg   : in billpro.delega : descrip, mask "5>a";
ddeleg  : billpro.delega.descrip, skip;
fdelega : in billpro.delega: descrip, mask "5>a";
ddelega : billpro.delega.descrip, skip;
ffilial : on help manual;
dfilial : skip;

agrclie	: check (clidesde <= clihasta),	on error ERR_CLIE;
clidesde: on help manual,  default 1, not null,
		  is (listapor == 1) ? void : null;
dclid	: skip;
clihasta: on help manual, default 999999999, not null,
		  is (listapor == 1) ? void : null;
dclih	: skip;
agrobje	: ;
objdesde: on help manual, default 1, not null,
		  is (listapor == 1) ? void : null;
dobjd	: skip;
objhasta: on help manual, default 9999, not null,
		  is (listapor == 1) ? void : null;
dobjh	: skip;
agrvigi : check (vigid <= vigih), on error ERR_VIGI;
vigid   : on help in sue.per(emp):apynom, not null, default 1;
dvigid  : sue.per.apynom, skip;
vigih   : on help in sue.per(emp):apynom descending, not null, default 9999999;
dvigih  : sue.per.apynom, skip;
defasa  : in (1:"Todos",
			  2:"Defasados a más",
			  3:"Defasados a menos"),
			not null, default 1;
ddefasa : is descr(defasa);
cambcate: in (1:"Todos",
			  2:"Ultimo"),
		  not null, default 1;
dcambcat: is descr(cambcate);
difer   : default false;
compsue : default false; //is (difer == false) ? void : null,
supdif  : default false;
salida  : in ("I":"Impresora",
			  "T":"Terminal",
			  "A":"Archivo"),
		  not null, default "I", mask ">A";
dsalida : is descr(salida);
nomarch : is (salida == "A") ? void : null, not null;
procvigi: skip;
dprocvig: skip;
