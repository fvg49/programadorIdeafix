
 Empresa        :        __. _________________________________

 Cliente Desde  :{_________. _________________________________________
 Cliente Hasta  : _________.}_________________________________________

 Objetivo Desde :     {____. _________________________________________
 Objetivo Hasta :      ____.}_________________________________________

 Período Desde  :{__/__/____
         Hasta  : __/__/____}

 Salida         : _  _________  ____________________

                   ___________________________________________________

%form
use operac, bill, sue, comerc;
language "C";
window label "[Listado de Control de Horas de Servicio]",border single;
confirm update, ignore, end;
ignore add, delete;

messages
		MAL_FECHA : "La fecha ingresada es %s debe ser %s",
		ERR_CLIE  : "El Cliente Desde debe ser menor o igual al Cliente Hasta",
		ERR_OBJE  : "El Objetivo Desde debe ser menor o igual al Objetivo Hasta";

%fields
emp     : in sue.emps:(descrip), default $emp, not null;
demp    : sue.emps.descrip, skip;

agrclie : check (clidesde <= clihasta), on error ERR_CLIE;
clidesde: on help in bill.cliente:(razsoc),	not null, default 0;
dclid   : bill.cliente.razsoc, skip;
clihasta: on help in bill.cliente:(razsoc),	not null, default 999999999;
dclih   : bill.cliente.razsoc, skip;

agrobje : check (objdesde <= objhasta),	on error ERR_OBJE;
objdesde: on help in comerc.objetivo by est(emp, true, clidesde):descrip, not null, default 1;
dobjd   : comerc.objetivo.descrip, skip;
objhasta: on help in comerc.objetivo by est(emp, true, clihasta):descrip, not null, default 99;
dobjh   : comerc.objetivo.descrip, skip;

agrupf  : check fechad <= fechah;
fechad  : not null, default today;
fechah  : not null, default today;

salida  : in ("T":"Terminal",
              "I":"Impresora",
              "A":"Archivo"),
          default "A", mask ">A", not null;
desc5   : is descr(salida);
nomarch : is (salida == "A") ? void : null, default "horas.dat", not null;

coment  : skip;
