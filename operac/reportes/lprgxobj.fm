
 Empresa           : __.  ______________________________________________

 Delegación Comercial  : _____  _________________________________
 Delegación Operacional: _____  _________________________________   
 Filial Operativa      : ______ _________________________________ 

 Programador Desde : _,___,___.  ______________________________________
 Programador Hasta : _,___,___.  ______________________________________

 Considera Objetivos Inactivos? : __?
 Mostrar Objetivos sin Programador Asignado? : __?
 Mostrar Objetivos con Servicio : __?  Fecha __/__/____

 Salida         : _  _________
 Nombre Archivo : ____________________

                 ___________________________________________________
%form
language "c";
use operac, sue, bill, comerc, billpro;
window label "[Listado de Programadores por Objetivos]", border single;
display status;
ignore delete, next, prev, add, ignore;
confirm update, end;

%fields
emp		: in sue.emps:(descrip), default $emp, not null;
demp	: sue.emps.descrip,	skip;

deleg   : in billpro.delega : descrip, mask "5>a";
ddeleg  : billpro.delega.descrip, skip;
fdelega : in billpro.delega: descrip, mask "5>a";
ddelega : billpro.delega.descrip, skip;
ffilial : on help manual;
descrip : comerc.filial.descrip, skip;

progdes : in sue.per(emp):(apynom);
dprogdes: sue.per.apynom, skip;
proghas : in sue.per(emp):(apynom);
dproghas: sue.per.apynom, skip;
objinact: default false;
objsasig: default false;
objcserv: default false;
fecha   : ;
salida  : in   ("A":"Archivo"),
			default "A", mask ">A",	not null;
dsalida : is descr(salida);
nomarch : is (salida != "A") ? null : void, default "lprgxobj.txt", not null;
coment  : skip;
