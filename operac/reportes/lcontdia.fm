
   Empresa : __. ________________________________________________

   Delegación Comercial  : _____  _________________________________
   Delegación Operacional: _____  _________________________________   
   Filial Operativa      : ______ _________________________________ 
   
   Legajo Desde :{_______. _____________________________________
          Hasta : _______.}_____________________________________

   Fecha Desde :{__/__/____
         Hasta : __/__/____}

   Salida : _ _________________________ Archivo : _________________

                 ___________________________________________________
%form
use sue, billpro, comerc;
language "c";
window label "Listado de Control Diario", border single;
confirm update, ignore, end;
ignore add, delete;

%fields
emp	   : in emps:descrip, default $emp, not null;
demp   : emps.descrip, skip;

deleg   : in billpro.delega : descrip, mask "5>a";
ddeleg  : billpro.delega.descrip, skip;
fdelega : in billpro.delega: descrip, mask "5>a";
ddelega : billpro.delega.descrip, skip;
ffilial : on help manual;
descrip : comerc.filial.descrip, skip;

agrleg : check nrolegd <= nrolegh;
nrolegd: on help in per(emp):apynom, not null, default 1;
apynomd: per.apynom, skip;
nrolegh: on help in per(emp):apynom descending, not null, default 999999;
apynomh: per.apynom, skip;
agrfec : check fechad<=fechah;
fechad : not null, default today;
fechah : not null, default today;
salida : in ("I": "Impresora", "T":"Terminal", "A":"Archivo"), not null, default "I", mask ">A";
dsalida: is descr(salida);
archivo: is (salida != "A") ? null : void,
            default "diario.txt";				
coment : skip;
