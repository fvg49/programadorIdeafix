%form
window label "[Listado de Asignacion con Rol]", border single;
confirm update, end;
ignore prev, delete, next, add;
display status;

%fields
salida  : in ("printer", "terminal", "asigrol delimited"), default "printer", not null;
dummy   : is help (PROCESAR);
