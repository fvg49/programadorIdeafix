%form
use comerc, sue;                
language "C";
window label "[Listado de Retroactivos]", border single;
confirm update, end;
ignore prev, delete, next, add;
display status;

%fields           
titulo  : skip;
fdesde  : not null;
fhasta  : not null;
frdesde : not null;
frhasta : not null;
//salida  : in ("printer", "terminal"), default "printer", not null;
salida	: in ("T":"Terminal", "I":"Impresora", "A": "Archivo"), default "I", mask ">A";
dsalida	: is descr(salida);    
archivo : is salida = "A" ? void : null, not null;      
dummy   : is help (PROCESAR);
comentario : skip;


