%form
// Form generated by IdeaFix [21/07/98 12:42]
use comerc, sue, bill, billpro;
language "c";
window label "Orden de Trabajo", border single;
display status;
confirm add, update, ignore, end;
ignore delete;
messages
	NOCLI	: "Código de Cliente Inválido.",
	NOOBJ	: "Código de Objetivo Inválido.",
	NODELEG : "La delegación no está asociada a la serie Ingresada.",
	ESPOR   : "El tipo de servicio es esporádico por lo tanto la fecha es obligatoria.",
	ABRIR   : "Debe actualizar conceptos de facturación.";

%fields
emp			: ot., in sue.emps:(descrip), default 1;
demp		: sue.emps.descrip, skip;
tipcomp		: ot., default 2;
dcomp		: ncbtes.descor, skip;
serie		: ot., default 1;
dserie		: nseries.descor, skip;
deleg		: ot., not null, in billpro.delega : descrip, mask "3>a", default "BA";
ddeleg		: billpro.delega.descrip, skip;
nroot		: ot., on help in ot(emp, tipcomp, serie, deleg);
clieot		: ot.cliente, on help manual, not null, default 1000;
dclie		: skip;
objet		: ot., on help manual, not null, default 6;
dobj		: skip;
fecreg		: ot., skip;
abm			: ot., has before;
finicio		: ot., >= "01011995";
hinic		: ot.hinicio;
ffinal		: ot., >= finicio;
hfin 		: ot.hfinal;

multiot		: rows 10, display 5;
m_ptoser	: ptoser.tippto, on help manual, unique;
i_ptoser	: internal ptoser.tippto;
i_modpto    : internal bool, default false;
m_dcopues	: skip;
i_totpers	: internal num(4);
m_cond		: ptoser.cond, not null,
			  manual subform ptoper(m_ptoser, i_modsub, totpers), default "A", mask ">A", has after;
i_modsub	: internal bool, default false;
totpers		: skip; 
coment      : skip;
