   Cantidad de Puestos: _,___.

%form
// Form generated by IdeaFix [01/12/03 12:52]
use operac, comerc, bill, sue;
window label "[Puestos de Objetivos Brigada]", border single;
confirm add, end, ignore;
ignore next, prev, delete; //, update;
messages MALFEC: "Fecha Inicio debe ser mayor o igual a Fecha Inicio de Actividad.";

%fields
cliente  : puestos.cliente, on help in bill.cliente:(razsoc), not null;
dclie    : bill.cliente.razsoc, skip;
objet    : puestos.objet, in comerc.objetivo (cliente):descrip, not null;
dobj     : comerc.objetivo.descrip, skip;
fecini   : comerc.objetivo.fechac, skip;
tippto   : puestos.tippto, in comerc.tptoser:(descrip), not null, default 27;
dptoser  : comerc.tptoser.descrip, skip;
codint   : puestos.codint, on help in puestos(cliente, objet, tippto):(puesto), not null;

categ    : puestos.puesto, in sue.cate(1): (denom), default 358;
dcateg   : sue.cate.denom, skip;

ptime    : not null, default false;
agrupt   : is (ptime == false ? null : void), not null;
horapt   : puestos.;
codfrec  : puestos., in operac.frecuen:descrip, is (ptime == false or horapt != null ? null : void),
           mask "2>a"; 

descfre  : frecuen.descrip, skip;

agrupf   : ;
finicio  : puestos., >= fecini, on error MALFEC, not null;
ffinal   : puestos., >= finicio;
agruph   : ;
hinicio  : puestos., is (horapt != null ? "00:00" : void), not null, default "00:00";
hfinal   : puestos., is (horapt != null ? "00:00" : void), >= hinicio, default "23:59";

agrupd   : not null;
dias1    : puestos.dia1, is (horapt != null ? "P" : void),
           in ("L":"Lunes",     "M":"Martes",
               "X":"Miércoles", "J":"Jueves",
               "V":"Viernes",   "S":"Sábado",
               "D":"Domingo",   "P":"Part Time");
dias2    : puestos.dia2, is (horapt != null ? null : void),
           check this != dias1,
           in ("L":"Lunes",     "M":"Martes",
               "X":"Miércoles", "J":"Jueves",
               "V":"Viernes",   "S":"Sábado",
               "D":"Domingo",   "P":"Part Time");
dias3    : puestos.dia3, is (horapt != null ? null : void),
           check (this != dias1 and this != dias2),
           in ("L":"Lunes",     "M":"Martes",
               "X":"Miércoles", "J":"Jueves",
               "V":"Viernes",   "S":"Sábado",
               "D":"Domingo",   "P":"Part Time");
dias4    : puestos.dia4, is (horapt != null ? null : void),
           check (this != dias1 and this != dias2 and this != dias3),
           in ("L":"Lunes",     "M":"Martes",
               "X":"Miércoles", "J":"Jueves",
               "V":"Viernes",   "S":"Sábado",
               "D":"Domingo",   "P":"Part Time");
dias5    : puestos.dia5, is (horapt != null ? null : void),
           check (this != dias1 and this != dias2 and this != dias3 and this != dias4),
           in ("L":"Lunes",     "M":"Martes",
               "X":"Miércoles", "J":"Jueves",
               "V":"Viernes",   "S":"Sábado",
               "D":"Domingo",   "P":"Part Time");
dias6    : puestos.dia6, is (horapt != null ? null : void),
           check (this != dias1 and this != dias2 and this != dias3 and this != dias4 and this != dias5),
           in ("L":"Lunes",     "M":"Martes",
               "X":"Miércoles", "J":"Jueves",
               "V":"Viernes",   "S":"Sábado",
               "D":"Domingo",   "P":"Part Time");
dias7    : puestos.dia7, is (horapt != null ? null : void),
           check (this != dias1 and this != dias2 and this != dias3 and
                  this != dias4 and this != dias5 and this != dias6),
           in ("L":"Lunes",     "M":"Martes",
               "X":"Miércoles", "J":"Jueves",
               "V":"Viernes",   "S":"Sábado",
               "D":"Domingo",   "P":"Part Time");

regim    : puestos., is (horapt != null ? "1x1x1" : void),
           in comerc.regimen by partime(ptime): descrip, default "6x1x8";

tipodia  : puestos.;
desc1    : is descr(tipodia);
cantvig  : puestos., not null, default 1;
cantpue  : puestos., not null, default 1;
