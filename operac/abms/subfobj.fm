%form(in i_clie)
// Form generated by IdeaFix [29/06/98 17:37]
use comerc;
language "C";
window label "[Objetivos de Clientes]", border single;
confirm add, update, delete;
ignore end;
display status;
messages
	ESTADO: "El Objetivo se encuentra en estado inactivo",
	OBJET : "El Objetivo ingresado ya tiene un Resúmen asignado";

%fields
i_clie	: internal num(9);			

multobj	: rows 99, display 9, ignore delete;
objet	: objetivo., on help manual, unique, has before, has after;//in objetivo(i_clie):(descrip), unique, has after;
i_intern: internal num(9); //, objetivo.intern;
descobj	: objetivo.descrip, skip;
estad   : in ("A": "Asigna",
              "D": "Desasigna"), default "A", mask ">A";
destad  : is descr(estad);
