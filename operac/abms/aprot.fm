%form                         
use sue, comerc;
language "C";
window label "Aprobación de OT", border single;
confirm add, update, ignore, end;
ignore delete;

%fields
nroemp	: in sue.emps:descrip, not null, default $emp;
demp	: sue.emps.descrip, skip;
posot   : ;
multi   : rows 2000, display 10, ignore delete;
emp     : skip;
tipcomp : skip;
serie   : skip;
deleg   : skip;
nroot   : skip;
abm     : skip;

i_emp   : internal num(2);
i_tipcomp: internal num(4);
i_serie : internal num(4);
cliente : skip;
objet   : skip;
fecreg  : skip;
aprueba : in (0: "Pendiente",
		      1: "Aprueba",
		      2: "Rechaza") ,
		  default 0, manual subform(motrech);
daprueb : is descr(aprueba);
tipser  : skip;
dtipser : skip;


