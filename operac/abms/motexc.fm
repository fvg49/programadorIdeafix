%form
// Form generated by IdeaFix [21/09/98 12:01]
use operac, sue;
window label "[Motivo de Excepción]", border single;
display status;

%fields
codcond: motexc., in condicion:(descrip);
descond: condicion.descrip, skip;
codmot : motexc., on help in motexc(codcond):(descrip);
descrip: motexc.;
valcli : motexc.;
vemp   : motexc., in sue.var(1):descrip;
vdemp  : sue.var.descrip, skip;
tipmot : motexc., in (1: "No se considera Excepción", 
                      2: "No es Excepción - Se Descuenta del sueldo ");
tipdmot : is descr(tipmot);

