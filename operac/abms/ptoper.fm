%form(in i_tpues,  out i_modptog, out i_totvig)
// Form generated by IdeaFix [21/07/98 18:18]
use comerc, sue, operac;
language "C";
window label "[Puestos]", border single;
display status;
ignore end;//, add, update, delete;
messages
	EQDIAS	: "No podrán repetirse los días en una misma línea.",
	PTOS	: "El puesto ingresado ya está dado de alta para el cliente.",
	PRESION	: "Presione INICIO para ver la composición del salario.",
	DELPUE	: "La cantidad de puestos a dar de baja supera a la cantidad de puestos vigentes.",
    AYUDA   : "Presione INICIO para ver los puestos a dar de baja.";

%fields
i_conv   : internal sue.conv.relacion;
i_tpues  : internal sue.cate.codcat;
i_modptog: internal bool;
i_emp    : internal num(2);

multi    : rows 50, display 5;

agrupm   : unique, has after when changed();
categor  : npuesto.puesto, on help manual, descr AYUDA; 
ptime  : not null, default false;
horapt : npuesto., is (ptime == false ? null : void);
hinicio  : npuesto., not null;
hfinal   : npuesto., not null;

agrupd   : not null, has after when changed();
dias1    : npuesto.dias; 
dias2    : npuesto.dias, check this != dias1; 
dias3    : npuesto.dias, check (this != dias1 and this != dias2);
dias4    : npuesto.dias, check (this != dias1 and this != dias2 and this != dias3);
dias5    : npuesto.dias, check (this != dias1 and this != dias2 and this != dias3 and this != dias4);
dias6    : npuesto.dias, check (this != dias1 and this != dias2 and this != dias3 and this != dias4 and
               this != dias5);
dias7    : npuesto.dias, check (this != dias1 and this != dias2 and this != dias3 and this != dias4 and
               this != dias5 and this != dias6);

regim    : npuesto., on help manual;
subreg   : npuesto., on help manual;
tipodia  : npuesto.;

i_modptom: internal bool, default false;
i_codint : internal operac.puestos.codint;
i_cantvig: internal operac.puestos.cantvig;
codfrec: npuesto., in operac.frecuen:descrip, is (ptime == false or horapt != null ? null : void), not null;
salario  : npuesto., manual subform saloper, display only, descr PRESION;
cantpue  : npuesto.;
i_cantp  : internal num(2);
cantvig  : npuesto.;
cond     : npuesto., default "A", mask ">A";
i_condc  : internal char(1);

i_totvig : internal num(4,2), is sum(cantvig);
