%form
// Form generated by IdeaFix [02/02/99 15:51]
use operac, sue;
language "c";
window label "[Carga de Vacaciones del Empleado]", border single;
display status;
confirm add, update, end, delete, ignore;
messages
		ERR_NO_ACT	 : "El Vigilador seleccionado está inactivo.",
		ERR_NO_VIG	 : "El Legajo seleccionado no es vigilador.",
		ERR_SUPERPOS : "Este día ya está incluido en el pedido de vacaciones:\ncon Fecha Desde: %.1D y Fecha Hasta: %.1D",
		ERR_FECING	 : "La Fecha Desde debe ser mayor a la fecha de ingreso del legajo : %.1D",
		ERR_FECEGR	 : "La Fecha Desde debe ser menor a la fecha de egreso del legajo : %.1D",
		ERR_FECEG	 : "La Fecha Hasta debe ser menor a la fecha de egreso del legajo : %.1D",
		ERR_PERIODO	 : "No puede ingresar las vacaciones para el periodo %d\nporque tiene pendiente las del periodo %d";

%fields
emp		: vacac., not null,	in sue.emps:descrip, default $emp;
demp	: sue.emps.descrip,	skip;
nroleg	: vacac., not null, on help manual;
apynom	: skip;
i_fecing: internal sue.per.fecing, sue.per.fecing;
i_fecegr: internal sue.per.fecegr, sue.per.fecegr;
i_activo: internal sue.per.activo, sue.per.activo;
i_relac : internal sue.per.relacion, sue.per.relacion;
i_ccosto: internal sue.per.codccos, sue.per.codccos;
periodo : vacac., not null, <= year;
diasper : skip;
//fecreg  : skip, default today;  
multi   : rows 10, display 5;
fdesde	: vacac., not null,	unique, has after;
cantdias: vacac., not null,	has after, > 0;
fhasta	: vacac., is fdesde + cantdias - 1;
i_fecreg: internal vacac.fecreg, vacac.fecreg;
modulo	: vacac.;
totaldia: is sum(cantdias);
mensaje : skip;
