%form
// Form generated by IdeaFix [19/05/11 12:13]
use operac;
window label "[Renglones del Rol]", border standard;
display status;
confirm  add, delete, update;

%fields
codrol: rrol. , in rol:(descrip);
desc0 : rol.descrip, skip;
fila  : rrol. ;
multi : rows 600, display 30;
agrup : unique;
colum : rrol. , on help in rrol(codrol, fila):(valor);
valor : rrol. ;
desc1 : is descr(valor);
