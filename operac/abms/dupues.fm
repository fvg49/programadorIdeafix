%form()
// Form generated by IdeaFix [29/06/98 17:37]
use comerc, bill, sue, billpro, operac;
language "C";
window label "[Duplicación de Puestos]", border single;
confirm update, end, ignore;
ignore next, prev, add, delete;
display status;

%fields
clie	: in bill.cliente:(razsoc, idtrib, tipdoc, nrodoc), not null;
descli 	: bill.cliente.razsoc, skip;
didtrib : bill.cliente.idtrib, skip;
ftipdoc : bill.cliente.tipdoc, skip;
fnrodoc : bill.cliente.nrodoc, skip;

objetcom: in objetivo(clie):(descrip, emp), not null;
descrip : objetivo.descrip, skip;
femp    : objetivo.emp, skip;
demp    : sue.emps.descrip, skip;
finid   : <= today, not null;
finih   : >= finid;
ffind   : >= finid, not null;
ffinh   : >= ffind;

clieop  : on help manual, autoenter;
descli2	: bill.cliente.razsoc, skip;
objetop : in billpro.objetrel by comer(clie, objetcom, clieop):empop, not null;
descr2  : objetivo.descrip, skip;
fempop  : objetivo.emp, skip;
demp2   : sue.emps.descrip, skip;

multi   : display 15, rows 150, ignore delete, ignore insert;
tippto  : operac.puestos., skip;
codint  : operac.puestos., skip;
puesto  : operac.puestos., skip;
hinicio : operac.puestos., skip;
hfinal  : operac.puestos., skip;
dia1    : operac.puestos., skip;
dia2    : operac.puestos., skip;
dia3    : operac.puestos., skip;
dia4    : operac.puestos., skip;
dia5    : operac.puestos., skip;
dia6    : operac.puestos., skip;
dia7    : operac.puestos., skip;
regim   : operac.puestos., skip;
cantvig : operac.puestos., skip;
cantpue : operac.puestos., skip;
tipodia : operac.puestos., skip;
finicio : operac.puestos., skip;
ffinal  : operac.puestos., skip;
duplica : not null, default false; 
