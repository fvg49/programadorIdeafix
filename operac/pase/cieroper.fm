
 Empresa          : __. __________________________________________

 Ultima Semana    : __?
 
 Cierre correspondiente al periodo   : __. / ____.
 que abarca desde : __/__/____ hasta : __/__/____ para Horas Normales
 y   abarca desde : __/__/____ hasta : __/__/____ para Horas Extras.

 Tipo de Cierre   :   _.  ________________________

 Horas Normales     : {__/__/____ - __/__/____}

 Horas Extras       : {__/__/____ - __/__/____}

 Horas Retroactivas : {__/__/____ - __/__/____}

[1m  ____________________________________________[0m

%form
// Form generated by IdeaFix [11/01/99 08:57]
use operac, sue;
language "c";
window label "[Cierre de Operaciones]", border single;
display status;
confirm update, end, ignore;
ignore add, delete;
messages
		ERR_PERI_CERRADO: "No se puede cerrar un periodo si no se pasó\nla información del periodo anterior a Denarius",
		ERR_FECNOR      : "La Fecha Desde debe ser menor o igual a la Fecha Hasta",
		ERR_FDESNOR     : "Debe seleccionarse una fecha dentro del rango indicado arriba para Horas Normales",
		ERR_FHASNOR     : "Debe seleccionarse una fecha dentro del rango indicado arriba para Horas Normales",
		ERR_FECEX       : "La Fecha Desde debe ser menor o igual a la Fecha Hasta",
		ERR_FDESEX      : "Debe seleccionarse una fecha dentro del rango indicado arriba para Horas Extras",
		ERR_FHASEX      : "Debe seleccionarse una fecha dentro del rango indicado arriba para Horas Extras",
		ERR_FDESRET     : "Debe seleccionarse una fecha dentro del rango indicado arriba para Horas de Retroactivos",
		ERR_FHASRET     : "Debe seleccionarse una fecha dentro del rango indicado arriba para Horas de Retroactivos";

%fields
emp       : cierre., in sue.emps:descrip, not null, default $emp, has after;
demp      : sue.emps.descrip, skip;
ultsem    : default false;
i_nrocier : internal operac.cierre.nrocier, operac.cierre.nrocier;
mesc      : cierre., skip;
anioc     : cierre., skip;
fdesnor   : skip;
fhasnor   : skip;
fdesex    : skip;
fhasex    : skip;
i_fdesret : internal date;
i_fhasret : internal date;
tipocier  : cierre., default 1, not null, has after;
dtipcier  : is descr(tipocier);

agrfn     : check (fecdnor <= fechnor), on error ERR_FECNOR;
fecdnor   : cierre.fdesnor, default fdesnor,
				check (this >= fdesnor), on error ERR_FDESNOR,
				skip when (tipocier == 2), not null;
fechnor   : cierre.fhasnor,	default fhasnor,
				check (this <= fhasnor), on error ERR_FHASNOR,
				skip when (tipocier == 2), not null;

agrfe     : check (fecdex <= fechex), on error ERR_FECEX;
fecdex    : cierre.fdesex, default fdesex,
				check (this >= fdesex), on error ERR_FDESEX,
				skip when (tipocier == 2), not null;
fechex    : cierre.fhasex, default fhasex,
				check (this <= fhasex), on error ERR_FHASEX,
				skip when (tipocier == 2), not null;

agrret    : check (fecdret <= fechret), on error ERR_FECEX;
fecdret   : cierre.fdesret, default i_fdesret,
			check (this >= i_fdesret), on error ERR_FDESRET,
			skip when (tipocier == 2), not null;
fechret   : cierre.fhasret,	default i_fhasret,
			check (this <= i_fhasret), on error ERR_FHASRET,
			skip when (tipocier == 2), not null;

comentario : skip;
