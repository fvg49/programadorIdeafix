%form
// Form generated by IdeaFix [11/01/99 08:57]
use operac, sue;
language "c";
window label "[Reversión del Cierre de Operaciones]", border single;
display status;
confirm update, end, ignore;
ignore add, delete;
messages
        ERR_PERI_INEX    : "No existe periodo asociado a esta Empresa!.",
        ERR_PERI_CERRADO : "El periodo asociado a esta Empresa ya fue cerrado!.\n No se puede volver a cerrar!.";

%fields
emp     : cierre., in sue.emps:descrip, has after;
demp    : sue.emps.descrip, skip;
agrup   : skip;
mesc    : cierre.;
anioc   : cierre.;
fdesnor : cierre.;
fhasnor : cierre.;
fdesex  : cierre.;
fhasex  : cierre.;
