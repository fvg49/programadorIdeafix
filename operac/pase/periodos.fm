 Para Hs.Normales manda mes completo ? : __?
 Horas normales : {__. - __.}

 Para Hs.Extras manda mes completo   ? : __?
 Horas extras   : {__. - __.}

%form
// Form generated by IdeaFix [12/01/99 17:15]
use operac, sue;
window label "[Periodos por Empresas]", border single;
display status;
confirm add, update, end, ignore, delete;
messages
         DIAS    : "Para días >= 29 tener en cuenta que no todos los meses tienen esa cantidad de días!\nCuando no se cumpla, se tomará el último día del mes",
         ERR_FEC : "Se debe ingresar un número entre 1 y 31!";

%fields
emp     : periodos., in sue.emps:descrip, not null, default $emp;
descrip : sue.emps.descrip, skip;
mescompn: periodos.;
agrnor  : has after;
ddesnor : periodos., is (mescompn == true) ? null : void, not null, descr DIAS,
          check this > 0 and this < 32, on error ERR_FEC;
dhasnor : periodos., is (mescompn == true) ? null : void, not null, descr DIAS,
          check this > 0 and this < 32, on error ERR_FEC;
mescompe: periodos.;
agrex   : has after;
ddesex  : periodos., is (mescompe == true) ? null : void, not null, descr DIAS,
          check this > 0 and this < 32, on error ERR_FEC;
dhasex  : periodos., is (mescompe == true) ? null : void, not null, descr DIAS,
          check this > 0 and this < 32, on error ERR_FEC;
