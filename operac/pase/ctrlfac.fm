
 Empresa          : __. __________________________________________

 Cliente  Desde : {_________.  _________________________________________
          Hasta :  _________.} _________________________________________

 Objetivo Desde :      {____.  _________________________________________
          Hasta :       ____.} _________________________________________

 Período  Desde :{__/__/____
          Hasta : __/__/____}

 Procesando día    __/__/____ de ____________

%form
// Form generated by IdeaFix [11/01/99 08:57]
use operac, bill, comerc, sue;
language "c";
window label "[Control del pasaje de horas a Facturación]", border single;
display status;
confirm update, end, ignore;
ignore add, delete;

messages
		ERR_CLIE : "El Cliente Desde debe ser menor o igual al Cliente Hasta",
		ERR_OBJE : "El Objetivo Desde debe ser menor o igual al Objetivo Hasta",
		ERR_FCH  : "La Fecha Desde debe ser menor o igual a la Fecha Hasta";

%fields
emp       : in sue.emps:descrip, not null, default $emp, has after;
demp      : sue.emps.descrip, skip;

agrclie : check (clid <= clih), on error ERR_CLIE;
clid    : on help in bill.cliente:(razsoc), not null, default 3001;
dclid   : bill.cliente.razsoc, skip;
clih    : on help in bill.cliente:(razsoc), not null, default 999999999;
dclih   : bill.cliente.razsoc, skip;

agrobje : check (objd <= objh), on error ERR_OBJE;
objd    : on help in comerc.objetivo by est(emp, true, clid):descrip, not null, default 0;
dobjd   : comerc.objetivo.descrip, skip;
objh    : on help in comerc.objetivo by est(emp, true, clih):descrip, not null, default 99;
dobjh   : comerc.objetivo.descrip, skip;

agrupf  : check fechad <= fechah, on error ERR_FCH;
fechad  : not null;
fechah  : not null;

comentario : skip;
dcomentario: skip;
