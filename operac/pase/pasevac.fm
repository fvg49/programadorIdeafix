
   Empresa               : __.    __________________________________________

   Fecha de Salida Desde :{__/__/____
                   Hasta : __/__/____}

%form
// Form generated by IdeaFix [02/02/99 15:51]
use operac, sue;
language "c";
window label "[Pasaje de Vacaciones de Vigiladores]", border single;
display status;
confirm add, update, end, delete, ignore;
messages
		ERR_FECHA	 : "La Fecha Desde debe ser menor a la fecha Hasta";

%fields
emp	   : not null, in sue.emps:descrip, default $emp;
demp   : sue.emps.descrip,	skip;

agrupf : check fdesde <= fhasta, on error ERR_FECHA;
fdesde : not null;
fhasta : not null;
