
 Empresa         :        __. ______________________________________

 Filial          : ______     _________________________________ 
  
 Cliente  Desde  :{_________. ____________________________________
          Hasta  : _________.}____________________________________

 Objetivo Desde  :     {____. ____________________________________
          Hasta  :      ____. ____________________________________}

 Fecha    Desde  :{__/__/____
          Hasta  : __/__/____}  

 ________________ _ ______________________
 
			________________________________________

            [1m__________________________________________________________[0m
%form
use operac, sue, bill, comerc;
language "C";
window label "Proceso de Generación del Parte", border single;
confirm end, update;
ignore delete;
messages
		FECHA: "La fecha debe ser mayor o igual al 24/12/2001.";

%fields
i_csalida	: internal char(25), is "Salida         :" ;
i_msoloimp	: internal char(25), is "Solo impresión" ;

emp    : parte., in sue.emps:(descrip), default $emp, not null;
demp   : sue.emps.descrip, skip;
ffilial: on help manual;
descrip: comerc.filial.descrip, skip; 
agrcli : ;
clied  : parte.cliente, on help manual, not null;
dclied : skip;
clieh  : parte.cliente, on help manual, not null, >= clied, check after agrcli;
dclieh : skip;
agrobj : ;
objetd : parte.objetivo, on help manual, not null;
dobjd  : skip;
objeth : parte.objetivo, on help manual, not null;
dobjh  : skip;
agrfec : check fhasta >= fdesde;
fdesde : parte.dia, default today, not null, >= "241201", on error FECHA;
fhasta : default today, not null;
//
i_soloimp	: internal bool;
csalida	: is i_soloimp==true? i_csalida : null;
salida  : in ("T": "Terminal", "I":"Impresora"), mask ">A", autoenter, not null, default "", 
			skip when i_soloimp=false;
dsalida : is descr(salida);
fsoloimp: is i_soloimp==true? i_msoloimp : null;
//
coment : skip;
