%form
// Form generated by IdeaFix [18/05/95 16:15]
language "c";
use operac, sue, bill, comerc;
window label "[Asignación de Vigiladores]", border single;
display status;
ignore delete, next, prev;
confirm add, update, end, ignore;
messages
		MSG_INF		 : "Presionando la tecla INICIO se muestra donde está asignado el Vigilador",
		MSG_SUBFM	 : "Presionando la tecla INICIO se podrá ingresar el horario de Trabajo para el Vigilador corresp.";        
%fields
emp       : asig., in sue.emps:(descrip), default $emp;
empdesc   : sue.emps.descrip, skip;
clieot    : asig.cliente, on help manual, not null;
dclieot   : bill.cliente.razsoc, skip;
objet     : asig.objetivo, on help manual,  not null;
dobjet    : comerc.objetivo.descrip, skip;

multi0    : rows 2000, display 10; // has before;
agruplin  : ;
nroleg    : asig., manual subform asige4(),	descr MSG_INF, on help manual; // unique;

nombre    : sue.per.apynom, skip;
i_base    : internal bool, default false;
i_new     : internal bool, default false;
i_cliefec : internal num(9);   //Cliente  donde esta efectivo para no valid superposicion cuando cambia de pto efectivo.
i_objefec : internal num(2);   //Objetivo donde esta efectivo para no valid superposicion cuando cambia de pto efectivo.
i_ptoefec : internal num(2);   //Ptoser   donde esta efectivo para no valid superposicion cuando cambia de pto efectivo.
i_codintefec: internal num(2); //Codint   donde esta efectivo para no valid superposicion cuando cambia de pto efectivo.
i_ffinptoefc: internal date;   //FechaFin donde esta efectivo para no valid superposicion cuando cambia de pto efectivo.
i_ptoasi  : internal num(2);   //Ptoser donde esta asignado para grabarlo en asigh cuando desasigno
i_codinasi: internal num(2);   //Codint donde esta asignado para grabarlo en asigh cuando desasigno
i_intasi  : internal num(2);   //Nroint donde esta asignado para grabarlo en asigh cuando desasigno
asigna    : not null,
            in (0:"Desasigna",1:"Asigna"),
            subform(asige2(emp),null);
descasi   : is descr(asigna);
agrasigna : ;
is_efect  : internal char(1);
efect     : asig., is (asigna == 0 ? efect : void), not null, mask ">a";
defect    : is descr(efect);
vigilad   : asig.vigil, is (asigna == 0 ? vigilad : void), not null, mask ">a";
dvigil    : is descr(vigilad);

i_chgefec0 : internal bool, default false;
i_fecefec : internal date, default null;
i_fecinin : internal date;
i_fecfinn : internal date;
i_fecini  : internal date;
i_fecfin  : internal date;

horario   : manual subform asige1(efect, i_base, vigilad, i_fecini, i_fecfin, i_chgefec0),
            is (asigna == 1 ? void : null),
            descr MSG_SUBFM, has after;

linea    : skip, default "¡¡¡¡¡¡¡¡¡¡¡¡¡¡¡";

mensaje   : skip;
