%form
// Form generated by IdeaFix [18/05/95 16:15]
language "c";
use operac, sue, bill, comerc;
window label "[Asignación de Vig. Anteriores]", border single;
display status;
ignore delete, next, prev;
confirm add, update, end, ignore;
messages
		MSG_INF		 : "Presionando la tecla INICIO se muestra donde está asignado el Vigilador",
		MSG_SUBFM	 : "Presionando la tecla INICIO se podrá ingresar el horario de Trabajo para el Vigilador corresp.",
		ERR_EFECT	 : "El Vigilador ya se encuentra efectivo en el Cliente: %ld y Objetivo: %d",
		ERR_EFEC     : "El Vigilador ya se encuentra asignado en forma efectiva en el cliente/objetivo",
		NO_ESTA_EFEC : "El Vigilador no tiene asociado un puesto donde este efectivo.\nPara asignarlo como provisorio, primero debe estar efectivo!",
		ERR_ASIG_HS	 : "No se puede realizar esta desasignación que ya tiene horas cargadas!",
		ERR_ACT		 : "No se pudo llevar a cabo la actualización.",
		TIENE_PROVI	 : "El Vigilador tiene asignaciones provisorias!.\nNo se puede desasignar el puesto donde está efectivo.",
		LEGINAC		 : "El Legajo se encuentra inactivo.",
		ERR_VIG      : "El Vigilador ya es de tipo %s",
		ERR_ASIG_VIG : "El Vigilador ya es de tipo %s en el Cliente %ld y Objetivo %d.";

%fields
emp       : asig., in sue.emps:(descrip), default $Nroempresa;
empdesc   : sue.emps.descrip, skip;
clieot    : asig.cliente, in bill.cliente:(razsoc), not null, has after;
dclieot   : bill.cliente.razsoc, skip;
objet     : asig.objetivo, on help in comerc.objetivo by emp(emp,clieot):descrip, not null, has after;
dobjet    : comerc.objetivo.descrip, skip;
multi0    : rows 500, display 10; // has before;
nroleg    : asig., in sue.per(emp):(apynom), manual subform asigh4(),	descr MSG_INF; // unique;
nombre    : sue.per.apynom, skip;
i_row     : internal num(3);
i_activ   : internal sue.per.activo, sue.per.activo;
i_codcat  : internal sue.per.codcat, sue.per.codcat;
i_base    : internal bool, default false;
i_new     : internal bool, default false;
i_cliefec : internal num(9);   //Cliente  donde esta efectivo para no valid superposicion cuando cambia de pto efectivo.
i_objefec : internal num(2);   //Objetivo donde esta efectivo para no valid superposicion cuando cambia de pto efectivo.
i_ptoefec : internal num(2);   //Ptoser   donde esta efectivo para no valid superposicion cuando cambia de pto efectivo.
i_codintefec: internal num(2); //Codint   donde esta efectivo para no valid superposicion cuando cambia de pto efectivo.
i_ptoasi  : internal num(2);   //Ptoser donde esta asignado para grabarlo en asigh cuando desasigno
i_codinasi: internal num(2);   //Codint donde esta asignado para grabarlo en asigh cuando desasigno
i_intasi  : internal num(2);   //Nroint donde esta asignado para grabarlo en asigh cuando desasigno
asigna    : not null,
            in (0:"Desasigna",1:"Asigna"),
            is ((i_base == false or efect == "E") and i_activ == true) ? 1 : void,
//            is (i_base == false or efect == "E") ? 1 : void,
            subform(asigh2(emp, i_fecini, i_fecfin),null);
descasi   : is descr(asigna);
agrasigna : ;
is_efect  : internal char(1);
efect     : asig., is (asigna == 0 ? efect : void), not null, mask ">a";
defect    : is descr(efect);
//i_wiefect : internal char(1);  //guardo el valor anterior de "efect" para comparar en el WiDialog.
vigilad   : asig.vigil, is (asigna == 0 ? vigilad : void), not null, mask ">a";
dvigil    : is descr(vigilad);

i_chgefec0: internal bool, default false;
i_fecefec : internal date, default null;
i_fecini  : internal date;
i_fecfin  : internal date;

horario   : subform asigh1(emp, clieot, objet, efect, nroleg, i_row, i_base, nombre, vigilad, i_codcat, i_fecefec, i_fecini, i_fecfin, i_chgefec0),
            is (asigna == 1 ? void : null),
            descr MSG_SUBFM, has after; // when (i_fecefec == null and efect == "P" and i_pasoef == false);
