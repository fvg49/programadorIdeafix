/* Field names	*/
# define REMPRE          ((rpfield)   0) 	/* String */
# define ROFPAGV         ((rpfield)   1) 	/* Num */
# define RDOFPAGV        ((rpfield)   2) 	/* String */
# define ROFPAGN         ((rpfield)   3) 	/* Num */
# define RDOFPAGN        ((rpfield)   4) 	/* String */
# define CLIE            ((rpfield)   5) 	/* Num */
# define DCLIE           ((rpfield)   6) 	/* String */
# define OBJ             ((rpfield)   7) 	/* Num */
# define DOBJ            ((rpfield)   8) 	/* String */
/* Report Checksum	*/
# define RP_CAMLPAG_CHKSUM ((long) 0x0046)
/* Zone names	*/
# define CABE            ((int)   0)
# define LINEA           ((int)   1)
# define FINAL           ((int)   2)
# define TOTAL           ((int)   3)
