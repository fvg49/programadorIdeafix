%form(in i_emp)
// Form generated by IdeaFix [18/05/95 16:15]
language "c";
use operac, sue;
window label "[Datos de Baja]", border single;
ignore delete, end;

%fields
i_emp		: internal num(2);
i_fecasig2  : internal date;

fecbaj		: asigh., not null;
errorasig	: is (i_fecasig2 != fecbaj ? false : void), not null, default true;
motivo		: asigh., in motivd by activo(true):descrip,
is (errorasig == true ? 98 : void), not null;
dmotvi		: motivd.descrip, skip;
reempl		: asigh., in sue.per(i_emp):(apynom), has after;
nombre2		: sue.per.apynom, skip;
i_act2		: internal sue.per.activo, sue.per.activo;
