%form(i_fechini6, i_fechfin6)
// Form generated by IdeaFix [18/05/95 16:15]
language "c";
use operac, sue;
window label "[Datos de Baja]", border single;
ignore delete, end;

%fields
i_emp6		: internal num(2);
i_fechini6	: internal date;
i_fechfin6	: internal date;

i_fecasig26 : internal date;

fecbaj6		: asigh.fecbaj,
				not null, display only;
motivo6		: asigh.motivo, in motivd by activo(true):descrip,
				not null;
dmotvi6		: motivd.descrip,
				skip;
reempl6		: asigh.reempl,
				in sue.per(i_emp6):(apynom),
				has after;
nombre26  	: sue.per.apynom,
				skip;
i_act26		: internal sue.per.activo,
				sue.per.activo;
