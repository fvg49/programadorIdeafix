%form
// Form generated by IdeaFix [13/08/07 12:42]
use comerc, aurus, bill, sue;
language "c";
window label "[Actualizacion de CODINTs]", border single;
display status;
confirm end, update;
ignore delete;

%fields
emp     : objetivo., on help in sue.emps:descrip, default $emp;
demp    : sue.emps.descrip, skip;
clie    : on help in bill.cliente:razsoc, is null when emp=null;
descli  : bill.cliente.razsoc,skip;
objet   : on help in objetivo by emp(emp,clie):(descrip), is null when clie=null;
desobj  : comerc.objetivo.descrip, skip;
limpia  : default false, on help in (true, false); 

coment	: skip, default null;
