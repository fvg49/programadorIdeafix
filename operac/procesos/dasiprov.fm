%form
// Form generated by IdeaFix [18/05/95 16:15]
language "c";
use operac;
window label "[Desasignación de Vigiladores Provisorios]", border single;
display status;
ignore delete, next, prev;
confirm update, end, ignore;

%fields
fecha : default today, <= today;
proce : is help (PROCESAR);

