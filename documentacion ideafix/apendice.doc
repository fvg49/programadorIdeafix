\par }}{\footerl \pard\plain \s26\qj\sl-220\slmult0\nowidctlpar\widctlpar\tqc\tx3035\tqr\tx6071\adjustright \cf1\lang3082 {\b\f4 \chpgn }{     IDEAFIX  }{\f4 Manual del Programador
\par }}{\footerr \pard\plain \s26\qr\sl-220\slmult0\nowidctlpar\widctlpar\tqc\tx3938\tqr\tx7877\tx10231\adjustright \cf1\lang3082 {IDEAFIX  }{\f4 Manual del Programador}{     }{\b\f4 \chpgn 
